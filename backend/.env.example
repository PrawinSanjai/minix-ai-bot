DATABASE_URL=postgresql://postgres:root@localhost:5432/minix_db
SECRET_KEY=replace-with-a-random-secret-at-least-32-characters
CORS_ALLOW_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
RATE_LIMIT_WINDOW_SECONDS=60
RATE_LIMIT_MAX_REQUESTS=120
MAX_REQUEST_BODY_BYTES=25000
GEMINI_API_KEY=None
MINIX_API_KEY=None
REDIS_URL=redis://localhost:6379/0
REDIS_CACHE_TTL_SECONDS=60
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_TIMEOUT_SECONDS=30
CHAT_JOB_STREAM=minix:chat:jobs
CHAT_JOB_GROUP=minix-chat-workers
CHAT_JOB_MAX_ATTEMPTS=4
CHAT_JOB_RECLAIM_IDLE_MS=60000
CHAT_JOB_ORPHAN_SECONDS=900
CHAT_WORKER_CONCURRENCY=4
MEMORY_SUMMARY_EVERY=10
